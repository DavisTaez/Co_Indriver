<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#1A1C22"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvNumeroCarrera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrera #5"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvValorCarrera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_verde"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="$2.00"
            android:textColor="#2ECC71"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOdometros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNumeroCarrera"
            android:layout_marginTop="8dp"
            android:text="📍 24,012 → 24,018 km"
            android:textColor="#A0A5B5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvValorCarrera"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:text="● Completada"
            android:textColor="#2ECC71"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvKmRecorridos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvOdometros"
            android:layout_marginTop="4dp"
            android:text="📐 6 km"
            android:textColor="#7A8093"
            android:textSize="12sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>