<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- CABECERA: Resumen del Día -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTotalGanancias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: $ 0.00"
                android:textColor="#2E7D32"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Km Recorridos: 0 km"
                android:textColor="#424242"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ESTADO DEL RECONOCIMIENTO DE VOZ -->
    <TextView
        android:id="@+id/tvEstadoVoz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardResumen"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Toca el botón para hablar..."
        android:textColor="#616161"
        android:textSize="14sp"
        android:textStyle="italic" />

    <!-- LISTA DE CARRERAS (TARJETAS) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarreras"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvEstadoVoz"
        android:layout_above="@id/btnBotonVoz"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false" />

    <!-- BOTÓN PRINCIPAL DE VOZ -->
    <Button
        android:id="@+id/btnBotonVoz"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="#1E88E5"
        android:text="Presionar para Hablar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</RelativeLayout>